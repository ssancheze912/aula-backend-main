# Server
PORT=3001
NODE_ENV=development

# CORS — URL del frontend (obligatoria en producción)
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK (Firebase Console → Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pegar la clave con \n literales, ej: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Firebase Auth REST (Firebase Console → Project settings → General → Web API Key)
FIREBASE_WEB_API_KEY=
