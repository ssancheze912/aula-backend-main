rules_version = '2';

// Reglas de seguridad de Firestore (TS-01 / TTS01-5).
//
// Arquitectura: el frontend NO escribe en Firestore directamente. Toda escritura
// pasa por backend-main usando el Admin SDK, que opera con privilegios y NO está
// sujeto a estas reglas. Por tanto, estas reglas son defensa en profundidad:
// niegan toda escritura desde clientes y limitan la lectura al propietario.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de usuario: el propietario puede leer su propio documento.
    // Las escrituras (crear/editar/borrar) solo ocurren vía backend (Admin SDK).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Reserva de usernames: gestionada exclusivamente por el backend.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // Todo lo demás queda denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
